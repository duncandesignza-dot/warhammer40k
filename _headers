# Cloudflare response headers (Workers static assets read this file).
# Images and icons rarely change: keep them for a month. The datasheet data changes at most weekly:
# keep it for an hour, and show the saved copy while fetching a fresh one for up to a week.
# The app's code and pages aren't listed, so browsers check for a new version every visit.
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/js/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
